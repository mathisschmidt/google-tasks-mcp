# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional when MCP_PUBLIC_URL is set (defaults to <MCP_PUBLIC_URL>/callback)
GOOGLE_REDIRECT_URI=https://your-domain.com/callback

# Encryption (generate with: npm run generate-secret)
ENCRYPTION_SECRET=your_32_character_or_longer_secret_here

# Server Configuration
# Bind address and port (PORT is still accepted as a fallback for MCP_PORT)
MCP_HOST=0.0.0.0
MCP_PORT=3000
# Public HTTPS URL of this server, without the /mcp path (used in OAuth metadata
# and as the default Google redirect URI base)
MCP_PUBLIC_URL=https://your-domain.com
# Password asked on the sign-in page before connecting a client (min 12 chars).
# Strongly recommended: without it, anyone who can reach the server can use it.
# Generate one with: openssl rand -base64 24
MCP_AUTH_PASSWORD=change-me-to-a-long-password
LOG_LEVEL=info

# CORS Configuration (optional, comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Rate limiting: only trust X-Forwarded-For / X-Real-IP when running behind a
# reverse proxy that overwrites them (default: false, uses the socket address)
TRUST_PROXY_HEADERS=false

# Deno KV storage path (self-hosting/Docker). Unset on Deno Deploy.
# KV_PATH=/data/kv.sqlite3
